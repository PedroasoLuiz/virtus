# ── Supabase ────────────────────────────────────────────────────
# Projeto herdado do VPAY FlutterFlow: gewshjjyqdfdcjtwlyas
NEXT_PUBLIC_SUPABASE_URL=https://gewshjjyqdfdcjtwlyas.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Nao existe service role aqui: o app roda todo sob o token do usuario, com RLS.
# Se um webhook precisar rodar sem usuario, a chave entra num arquivo proprio
# marcado `server-only` — nunca no client compartilhado.

# ── Integracoes ─────────────────────────────────────────────────
# WhatsApp: token, App Secret, verify token, phone id e WABA id NAO ficam aqui.
# Sao por empresa e por numero, cadastrados na tela (engrenagem do painel) e
# guardados no `supabase_vault`. Ver docs/15.
#
# Sobra so este: o segredo que protege as funcoes de ingestao do webhook contra
# quem tem apenas o anon key. Tem de ser igual a `whatsappconfig.segredo`.
WHATSAPP_WEBHOOK_SEGREDO=

# Envio de fatura por e-mail. Substitui o EmailJS do legado, que era feito para
# rodar no navegador — chave publica por design. Esta e secreta e NUNCA leva
# prefixo NEXT_PUBLIC_: com ele, o Next a embute no bundle do cliente.
RESEND_API_KEY=
# Remetente. Precisa ser de um dominio verificado no Resend, senao o envio so
# funciona para o proprio dono da conta.
RESEND_FROM=

# ── App ─────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
